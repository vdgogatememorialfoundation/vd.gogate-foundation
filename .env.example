# Database
DATABASE_URL="postgresql://postgres:vgmf@localhost:5432/vgmf?schema=public"

# Auth
AUTH_SECRET="change-me-32-chars-minimum-random-secret-value"
SESSION_TTL_HOURS=72

# Encryption key for stored integration credentials (32 bytes base64)
INTEGRATION_ENCRYPTION_KEY="change-me-base64-32-bytes"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Vaidya Gogate Memorial Foundation"
DEFAULT_LOCALE=en

# Bootstrap super admin (created on first seed if no super admin exists)
BOOTSTRAP_ADMIN_EMAIL="admin@vaidyagogate.org"
BOOTSTRAP_ADMIN_PASSWORD="Admin@2026"

# Mail (ZeptoMail). If unset, mail is logged to console.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL="noreply@vaidyagogate.org"
ZEPTOMAIL_FROM_NAME="Vaidya Gogate Memorial Foundation"

# Payments (Razorpay default gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
